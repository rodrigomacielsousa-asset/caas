{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Premium user account data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plano": { "type": "string", "enum": ["free", "pro", "advanced", "enterprise"] },
        "status": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Document": {
      "title": "Document (NF-e/XML)",
      "description": "Captured or consulted NF-e data",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "chave": { "type": "string" },
        "type": { "type": "string" },
        "emitente": { "type": "string" },
        "valor": { "type": "number" },
        "xml": { "type": "string" }
      }
    },
    "MonitoredClient": {
      "title": "Monitored Client",
      "description": "CNPJ registered for automatic monitoring",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "cnpj": { "type": "string" },
        "nome": { "type": "string" },
        "ultNSU": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and private user profile data"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Individual documents (NF-e) per user"
    },
    "/nfeMonitoredClients/{clientId}": {
      "schema": "MonitoredClient",
      "description": "Clients registered for SEFAZ monitoring"
    }
  }
}
