rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email == 'rodrigomaciel.sousa@gmail.com' && 
             isEmailVerified(); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Entity Validations ---

    function isValidProduct(data) {
      return data.slug is string && data.slug.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.priceValue is number;
    }

    function isValidSubmission(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.description is string && data.description.size() <= 2000;
    }

    function isValidCheckoutRequest(data) {
      return data.userEmail is string && data.items is list &&
             data.totalValue is number;
    }

    // --- Access Rules ---

    match /products/{productId} {
      allow read: if true; // Public marketplace
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true; // Public blog
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if true; // Lead capture
      allow read, update, delete: if isAdmin();
    }

    match /checkoutRequests/{requestId} {
      allow create: if true; // Log checkout attempts (anonymous)
      allow read, update: if isAdmin();
      allow list: if isAdmin();
    }

    match /entitlements/{entitlementId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Server handles this via admin SDK
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['plano', 'status', 'updatedAt'])
      ) || isAdmin();
    }

    // Legacy or internal paths
    match /documents/{docId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified();
      allow delete: if isAdmin();
    }

    match /trackingEvents/{eventId} {
      allow create: if true; 
      allow read: if isAdmin();
    }

    match /userPlans/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
